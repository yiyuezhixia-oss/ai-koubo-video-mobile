DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=
PUBLIC_BASE_URL=
ALLOW_PROVIDER_MOCKS=false
ALLOW_ANONYMOUS_AUTH=true
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# Media storage. Use "object" in production so every user and HiHoo can access
# uploaded files through a stable public HTTPS URL. "local" is development-only.
MEDIA_STORAGE_BACKEND=local
OBJECT_STORAGE_ENDPOINT_URL=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_PUBLIC_BASE_URL=

# Production requirements:
# DJANGO_DEBUG=false
# DJANGO_ALLOWED_HOSTS=api.example.com
# PUBLIC_BASE_URL=https://api.example.com
# MEDIA_STORAGE_BACKEND=object

# Text rewrite: https://platform.deepseek.com/api_keys
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Voice cloning and TTS: https://platform.minimax.io/user-center/basic-information/interface-key
MINIMAX_BASE_URL=https://api.minimax.io/v1
MINIMAX_API_KEY=
MINIMAX_SPEECH_MODEL=speech-2.8-hd

# HiHoo digital human API.
HIHOO_BASE_URL=https://api.hihookeji.com
HIHOO_API_KEY=
HIHOO_SIGN_SK=
HIHOO_ENABLE_SIGN=false
HIHOO_DIGITAL_HUMAN_ENDPOINT=/api/humanmeta/index
HIHOO_DIGITAL_HUMAN_QUERY_ENDPOINT=/api/queryclonehumanv3/index
HIHOO_DIGITAL_HUMAN_TASKTYPE=huamanclonev1
